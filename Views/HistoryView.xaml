<UserControl x:Class="StdfViewer.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Style.Card}">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8" LastChildFill="False">
                    <TextBlock Text="{DynamicResource Str.History.ParsedFiles}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str.History.Delete}"
                            Style="{StaticResource Style.Button.Secondary}"
                            Command="{Binding DeleteCommand}"/>
                </DockPanel>
                <ListView ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Str.Col.File}" Width="170" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="{DynamicResource Str.Col.Parsed}" Width="130" DisplayMemberBinding="{Binding ParsedAt}"/>
                            <GridViewColumn Header="{DynamicResource Str.Col.Size}" Width="92"
                                            DisplayMemberBinding="{Binding Size, StringFormat={}{0:N0}}"/>
                            <GridViewColumn Header="{DynamicResource Str.Col.Records}" Width="76"
                                            DisplayMemberBinding="{Binding Records, StringFormat={}{0:N0}}"/>
                            <GridViewColumn Header="{DynamicResource Str.Col.Types}" Width="56" DisplayMemberBinding="{Binding TypeCount}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"/>

        <Border Grid.Column="2" Style="{StaticResource Style.Card}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.History.LastResult}"
                           Style="{StaticResource Style.SectionTitle}"/>
                <TextBlock DockPanel.Dock="Top" Margin="12,0,12,8" Text="{Binding SummaryText}"
                           TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"/>
                <ListView ItemsSource="{Binding Types}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Str.Col.Type}" Width="60" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Typ,Sub" Width="70" DisplayMemberBinding="{Binding TypSub}"/>
                            <GridViewColumn Header="{DynamicResource Str.Col.Count}" Width="90"
                                            DisplayMemberBinding="{Binding Count, StringFormat={}{0:N0}}"/>
                            <GridViewColumn Header="{DynamicResource Str.Col.Bytes}" Width="100"
                                            DisplayMemberBinding="{Binding Bytes, StringFormat={}{0:N0}}"/>
                            <GridViewColumn Header="{DynamicResource Str.Col.First}" Width="70" DisplayMemberBinding="{Binding FirstSeq}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
