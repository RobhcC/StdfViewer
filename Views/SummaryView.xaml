<UserControl x:Class="StdfViewer.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,8,0,8">
            <WrapPanel Margin="14,10,14,10">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{DynamicResource Str.Kpi.Size}" Style="{StaticResource Style.Text.Info}"/>
                    <TextBlock Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{DynamicResource Str.Kpi.Records}" Style="{StaticResource Style.Text.Info}"/>
                    <TextBlock Text="{Binding RecordsText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{DynamicResource Str.Kpi.Types}" Style="{StaticResource Style.Text.Info}"/>
                    <TextBlock Text="{Binding TypesText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{DynamicResource Str.Kpi.Duts}" Style="{StaticResource Style.Text.Info}"/>
                    <TextBlock Text="{Binding DutsText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{DynamicResource Str.Kpi.Yield}" Style="{StaticResource Style.Text.Info}"/>
                    <TextBlock Text="{Binding YieldText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{DynamicResource Str.Kpi.Scan}" Style="{StaticResource Style.Text.Info}"/>
                    <TextBlock Text="{Binding ScanText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Kpi.Endian}" Style="{StaticResource Style.Text.Info}"/>
                    <TextBlock Text="{Binding EndianText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="1" Margin="12,8,0,0" Text="{DynamicResource Str.Summary.Empty}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Info}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFile}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFile}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Style.Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Style.SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="12,0,12,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource Brush.TextMuted}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListView ItemsSource="{Binding Bins}" Margin="12,0,12,10" MaxHeight="240">
                                    <ListView.Style>
                                        <Style TargetType="ListView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBins}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.Style>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="HEAD_NUM" Width="92"
                                                            DisplayMemberBinding="{Binding HeadNum}"/>
                                            <GridViewColumn Header="SITE_NUM" Width="92"
                                                            DisplayMemberBinding="{Binding SiteNum}"/>
                                            <GridViewColumn Header="BIN_NUM" Width="90"
                                                            DisplayMemberBinding="{Binding BinNum}"/>
                                            <GridViewColumn Header="BIN_CNT" Width="110"
                                                            DisplayMemberBinding="{Binding BinCount}"/>
                                            <GridViewColumn Header="BIN_PF" Width="80"
                                                            DisplayMemberBinding="{Binding BinPf}"/>
                                            <GridViewColumn Header="BIN_NAM" Width="300"
                                                            DisplayMemberBinding="{Binding BinName}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
