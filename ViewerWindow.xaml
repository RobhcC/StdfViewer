<Window x:Class="StdfViewer.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StdfViewer.Views"
        Title="STDF Viewer"
        Width="1500" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        Foreground="{StaticResource Brush.Text}">
    <DockPanel LastChildFill="True">

        <!-- 顶部工具栏（始终可见，与页签无关） -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Style.Toolbar}">
            <DockPanel LastChildFill="True" Margin="12,8,12,8">
                <Button DockPanel.Dock="Left" Content="{DynamicResource Str.Tb.Open}"
                        Style="{StaticResource Style.Button.Primary}"
                        Command="{Binding OpenCommand}"
                        IsEnabled="{Binding CanOpen}"/>
                <Button DockPanel.Dock="Left" Content="{DynamicResource Str.Tb.AllTypes}" Margin="8,0,0,0"
                        Style="{StaticResource Style.Button.Secondary}"
                        Command="{Binding Browse.AllTypesCommand}"
                        IsEnabled="{Binding IsBrowseTab}"/>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="76"
                        Style="{StaticResource Style.Button.Secondary}"
                        ToolTipService.ToolTip="{DynamicResource Str.Tb.LangTip}"
                        Content="{Binding LanguageButtonText}"
                        Command="{Binding ToggleLanguageCommand}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="76" Margin="10,0,4,0" VerticalAlignment="Center"
                             ToolTipService.ToolTip="{DynamicResource Str.Tb.JumpTip}"
                             IsEnabled="{Binding IsBrowseTab}"
                             Text="{Binding Browse.JumpText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Browse.JumpCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource Style.Text.Info}"
                               Text="{Binding StatusText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Margin="12,4,12,0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{DynamicResource Str.Tab.Summary}">
                <views:SummaryView DataContext="{Binding Summary}"/>
            </TabItem>
            <TabItem Header="{DynamicResource Str.Tab.Browse}">
                <views:BrowseView DataContext="{Binding Browse}"/>
            </TabItem>
            <TabItem Header="{DynamicResource Str.Tab.History}">
                <views:HistoryView DataContext="{Binding History}"/>
            </TabItem>
            <TabItem Header="{DynamicResource Str.Tab.Compare}">
                <views:CompareView DataContext="{Binding Compare}"/>
            </TabItem>
            <TabItem Header="{DynamicResource Str.Tab.Wafer}">
                <views:WaferView DataContext="{Binding Wafer}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
