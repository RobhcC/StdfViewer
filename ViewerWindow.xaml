<Window x:Class="StdfViewer.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STDF Viewer"
        Width="1500" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        Foreground="{StaticResource Brush.Text}">
    <DockPanel LastChildFill="True">

        <!-- 顶部工具栏（始终可见，与页签无关） -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Style.Toolbar}">
            <DockPanel LastChildFill="True" Margin="12,8,12,8">
                <Button x:Name="_open" DockPanel.Dock="Left" Content="{DynamicResource Str.Tb.Open}"
                        Style="{StaticResource Style.Button.Primary}" Click="OnOpenClick"/>
                <Button x:Name="_all" DockPanel.Dock="Left" Content="{DynamicResource Str.Tb.AllTypes}" Margin="8,0,0,0"
                        Style="{StaticResource Style.Button.Secondary}" Click="OnAllClick"/>
                <Button x:Name="_lang" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="76"
                        Style="{StaticResource Style.Button.Secondary}"
                        ToolTipService.ToolTip="{DynamicResource Str.Tb.LangTip}"
                        Click="OnLanguageClick"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="_jump" Width="76" Margin="10,0,4,0" VerticalAlignment="Center"
                             ToolTipService.ToolTip="{DynamicResource Str.Tb.JumpTip}"
                             KeyDown="OnJumpKeyDown"/>
                    <TextBlock x:Name="_info" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource Style.Text.Info}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="_tabs" Margin="12,4,12,0" SelectionChanged="OnTabChanged">

            <!-- ==================== 0. 汇总 ==================== -->
            <TabItem x:Name="_tabSummary" Header="{DynamicResource Str.Tab.Summary}">
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Style.Card}" Margin="0,8,0,8">
                        <WrapPanel Margin="14,10,14,10">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{DynamicResource Str.Kpi.Size}" Style="{StaticResource Style.Text.Info}"/>
                                <TextBlock x:Name="_kpiSize" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{DynamicResource Str.Kpi.Records}" Style="{StaticResource Style.Text.Info}"/>
                                <TextBlock x:Name="_kpiRecords" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{DynamicResource Str.Kpi.Types}" Style="{StaticResource Style.Text.Info}"/>
                                <TextBlock x:Name="_kpiTypes" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{DynamicResource Str.Kpi.Duts}" Style="{StaticResource Style.Text.Info}"/>
                                <TextBlock x:Name="_kpiDuts" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{DynamicResource Str.Kpi.Yield}" Style="{StaticResource Style.Text.Info}"/>
                                <TextBlock x:Name="_kpiYield" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{DynamicResource Str.Kpi.Scan}" Style="{StaticResource Style.Text.Info}"/>
                                <TextBlock x:Name="_kpiScan" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.Kpi.Endian}" Style="{StaticResource Style.Text.Info}"/>
                                <TextBlock x:Name="_kpiEndian" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <TextBlock x:Name="_summaryEmpty" Grid.Row="1" Margin="12,8,0,0"
                               Text="{DynamicResource Str.Summary.Empty}"
                               Style="{StaticResource Style.Text.Info}"/>

                    <ScrollViewer x:Name="_summaryScroll" Grid.Row="1"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="_summarySections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Style.Card}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Style.SectionTitle}"/>
                                            <ItemsControl ItemsSource="{Binding Fields}" Margin="12,0,12,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{StaticResource Brush.TextMuted}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ListView ItemsSource="{Binding Bins}" Margin="12,0,12,10" MaxHeight="240">
                                                <ListView.Style>
                                                    <Style TargetType="ListView">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBins}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListView.Style>
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="HEAD_NUM" Width="92"
                                                                        DisplayMemberBinding="{Binding HeadNum}"/>
                                                        <GridViewColumn Header="SITE_NUM" Width="92"
                                                                        DisplayMemberBinding="{Binding SiteNum}"/>
                                                        <GridViewColumn Header="BIN_NUM" Width="90"
                                                                        DisplayMemberBinding="{Binding BinNum}"/>
                                                        <GridViewColumn Header="BIN_CNT" Width="110"
                                                                        DisplayMemberBinding="{Binding BinCount}"/>
                                                        <GridViewColumn Header="BIN_PF" Width="80"
                                                                        DisplayMemberBinding="{Binding BinPf}"/>
                                                        <GridViewColumn Header="BIN_NAM" Width="300"
                                                                        DisplayMemberBinding="{Binding BinName}"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ==================== 1. 浏览 ==================== -->
            <TabItem x:Name="_tabBrowse" Header="{DynamicResource Str.Tab.Browse}">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="370"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Style.Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Browse.Types}"
                                       Style="{StaticResource Style.SectionTitle}"/>
                            <ListView x:Name="_types" SelectionChanged="OnTypeSelected">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Type}" Width="52" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Typ,Sub" Width="50" DisplayMemberBinding="{Binding TypSub}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Count}" Width="70" DisplayMemberBinding="{Binding Count}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Bytes}" Width="82" DisplayMemberBinding="{Binding Bytes}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.First}" Width="70" DisplayMemberBinding="{Binding FirstSeq}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1"/>

                    <Border Grid.Column="2" Style="{StaticResource Style.Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Browse.Records}"
                                       Style="{StaticResource Style.SectionTitle}"/>
                            <ListView x:Name="_records" SelectionChanged="OnRecordSelected">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="52" DisplayMemberBinding="{Binding No}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Type}" Width="50" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Typ,Sub" Width="50" DisplayMemberBinding="{Binding TypSub}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Offset}" Width="76" DisplayMemberBinding="{Binding Offset}"/>
                                        <GridViewColumn Header="LEN" Width="46" DisplayMemberBinding="{Binding Len}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="3"/>

                    <Border Grid.Column="4" Style="{StaticResource Style.Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="_recordHead" DockPanel.Dock="Top" Text="{DynamicResource Str.Browse.Fields}"
                                       Style="{StaticResource Style.SectionTitle}"/>
                            <ListView x:Name="_fields" Focusable="False">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Index}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Field}" Width="104" DisplayMemberBinding="{Binding NameText}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.StdfType}" Width="66" DisplayMemberBinding="{Binding Type}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Value}" Width="240" DisplayMemberBinding="{Binding ValueText}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.RawBytes}" Width="200" DisplayMemberBinding="{Binding Hex}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Status}" Width="90" DisplayMemberBinding="{Binding StatusText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== 2. 历史解析记录 ==================== -->
            <TabItem x:Name="_tabHistory" Header="{DynamicResource Str.Tab.History}">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Style.Card}">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8" LastChildFill="False">
                                <TextBlock Text="{DynamicResource Str.History.ParsedFiles}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="_historyDelete" DockPanel.Dock="Right" Content="{DynamicResource Str.History.Delete}"
                                        Style="{StaticResource Style.Button.Secondary}"
                                        Click="OnHistoryDeleteClick"/>
                            </DockPanel>
                            <ListView x:Name="_historyList" SelectionChanged="OnHistorySelected">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource Str.Col.File}" Width="170" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Parsed}" Width="130" DisplayMemberBinding="{Binding ParsedAt}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Size}" Width="92"
                                                        DisplayMemberBinding="{Binding Size, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Records}" Width="76"
                                                        DisplayMemberBinding="{Binding Records, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Types}" Width="56" DisplayMemberBinding="{Binding TypeCount}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1"/>

                    <Border Grid.Column="2" Style="{StaticResource Style.Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.History.LastResult}"
                                       Style="{StaticResource Style.SectionTitle}"/>
                            <TextBlock x:Name="_historySummary" DockPanel.Dock="Top" Margin="12,0,12,8"
                                       TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"/>
                            <ListView x:Name="_historyTypes">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Type}" Width="60" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Typ,Sub" Width="70" DisplayMemberBinding="{Binding TypSub}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Count}" Width="90"
                                                        DisplayMemberBinding="{Binding Count, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Bytes}" Width="100"
                                                        DisplayMemberBinding="{Binding Bytes, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.First}" Width="70" DisplayMemberBinding="{Binding FirstSeq}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== 3. 文件对比 ==================== -->
            <TabItem x:Name="_tabCompare" Header="{DynamicResource Str.Tab.Compare}">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Style.Card}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str.Compare.Pick}"
                                       Style="{StaticResource Style.SectionTitle}"/>
                            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                                <TextBlock Text="{DynamicResource Str.Compare.Left}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="_cmpLeftText" Margin="0,2,0,8" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Text="{DynamicResource Str.Compare.Right}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="_cmpRightText" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                                <Button x:Name="_cmpSetLeft" Content="{DynamicResource Str.Compare.SetLeft}"
                                        Style="{StaticResource Style.Button.Secondary}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        Click="OnSetLeftClick"/>
                                <Button x:Name="_cmpSetRight" Content="{DynamicResource Str.Compare.SetRight}"
                                        Style="{StaticResource Style.Button.Secondary}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        Click="OnSetRightClick"/>
                                <Button x:Name="_cmpCompare" Content="{DynamicResource Str.Compare.Run}"
                                        Style="{StaticResource Style.Button.Primary}"
                                        HorizontalAlignment="Stretch" Click="OnCompareClick"/>
                            </StackPanel>
                            <ListView x:Name="_cmpList">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource Str.Col.File}" Width="150" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Parsed}" Width="110" DisplayMemberBinding="{Binding ParsedAt}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1"/>

                    <Border Grid.Column="2" Style="{StaticResource Style.Card}">
                        <Grid Margin="12,0,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource Str.Compare.TypeDiff}" Margin="0,10,0,6"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="_cmpSummary" Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextMuted}"/>

                            <ListView x:Name="_cmpTypes" Grid.Row="2" ItemContainerStyle="{StaticResource Style.CompareRow}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Typ,Sub" Width="80" DisplayMemberBinding="{Binding TypSub}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Name}" Width="90" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Left}" Width="80"
                                                        DisplayMemberBinding="{Binding LeftCount, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Right}" Width="80"
                                                        DisplayMemberBinding="{Binding RightCount, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Delta}" Width="80"
                                                        DisplayMemberBinding="{Binding Delta, StringFormat={}{0:N0}}"/>
                                        <GridViewColumn Header="{DynamicResource Str.Col.Status}" Width="90" DisplayMemberBinding="{Binding StatusText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBlock Grid.Row="3" Text="{DynamicResource Str.Compare.Struct}" Margin="0,10,0,6"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="_cmpStruct" Grid.Row="4"
                                     Style="{StaticResource Style.TextBox.Multiline}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
